# Copy to .env and fill locally. Never commit .env.
#
# Blank settings run the deterministic path. A key runs the model path.
# Any OpenAI-compatible endpoint works; three are shown.
#
# A value already set in your shell overrides this file, because
# agent.py uses os.environ.setdefault when it loads .env.

BAHN_MODEL_API_KEY=
BAHN_MODEL_BASE_URL=
BAHN_MODEL_NAME=

# AnyAPI (what we use)
#   BAHN_MODEL_BASE_URL=https://api.anyapi.ai/v1
#   BAHN_MODEL_NAME=nvidia/nemotron-3.5-lightning:free
#
# OpenRouter
#   BAHN_MODEL_BASE_URL=https://openrouter.ai/api/v1
#   BAHN_MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free
#
# OpenAI
#   BAHN_MODEL_BASE_URL=https://api.openai.com/v1
#   BAHN_MODEL_NAME=gpt-4o-mini
#
# Local OpenAI-compatible server (llama.cpp, vLLM, LM Studio, Ollama)
#   BAHN_MODEL_BASE_URL=http://127.0.0.1:8080/v1
#   BAHN_MODEL_NAME=local-model
#   BAHN_MODEL_API_KEY=not-needed
